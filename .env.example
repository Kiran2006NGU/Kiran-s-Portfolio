# GEMINI_API_KEY: Required for Gemini AI API calls.
# On Vercel, add GEMINI_API_KEY in Project Settings -> Environment Variables.
# In local VS Code, copy this file to .env and put your Gemini API key here.
GEMINI_API_KEY="your_api_key_here"

# ADMIN_PASSCODE: Passcode for live portfolio editing
ADMIN_PASSCODE="kiran2006"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

